# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Number of trusted reverse-proxy hops between clients and this process.
TRUST_PROXY_HOPS=0

# Protect POST /v1/profiles. Comma-separated; leave empty only for local development.
API_KEYS=replace-with-a-long-random-key

# LinkedIn session cookies for direct Voyager endpoint requests. Never commit real values.
# Obtain both from a LinkedIn session you own and are authorized to use.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Endpoint extraction controls
SCRAPE_TIMEOUT_MS=45000
SCRAPE_CONCURRENCY=2
SCRAPE_QUEUE_MAX=20
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
CACHE_MAX_VALUE_BYTES=524288
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
MAX_RETRIES=1
